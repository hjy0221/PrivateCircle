{
  "name": "privatecircle-firebase-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test:rules": "XDG_CONFIG_HOME=${TMPDIR:-/tmp}/privatecircle-firebase-config firebase emulators:exec --project demo-privatecircle --only firestore \"node --test tests/firestore.rules.test.mjs\"",
    "login:firebase": "XDG_CONFIG_HOME=$HOME/.codex/privatecircle-firebase-config firebase login",
    "deploy:rules:production": "XDG_CONFIG_HOME=$HOME/.codex/privatecircle-firebase-config firebase deploy --only firestore:rules --project uri-sai-a8c73",
    "verify:rules:production": "XDG_CONFIG_HOME=$HOME/.codex/privatecircle-firebase-config node scripts/verify-published-rules.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.31.0"
  }
}
