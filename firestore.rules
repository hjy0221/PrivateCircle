rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedUser() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isGroupMember(groupId) {
      return verifiedUser()
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function isMeetupParticipant(groupId, meetupId) {
      let meetupPath = /databases/$(database)/documents/groups/$(groupId)/meetups/$(meetupId);
      return isGroupMember(groupId)
        && exists(meetupPath)
        && get(meetupPath).data.participantUIDs is list
        && get(meetupPath).data.participantUIDs.hasAny([request.auth.uid]);
    }

    function signedInEmail() {
      return request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.email == signedInEmail()
        && request.resource.data.createdAt == request.time;

      allow get, list: if signedIn() && request.auth.uid == userId;
      allow update, delete: if false;

      match /groups/{groupId} {
        allow get, list: if verifiedUser() && request.auth.uid == userId;
        allow create: if verifiedUser()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['groupID', 'name', 'createdAt'])
          && request.resource.data.groupID == groupId
          && request.resource.data.name is string
          && request.resource.data.createdAt == request.time
          && existsAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(userId))
          && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.name == request.resource.data.name;

        allow update, delete: if false;
      }

      match /sharedMeetupRefs/{referenceId} {
        allow get, list: if verifiedUser() && request.auth.uid == userId;

        allow create: if verifiedUser()
          && request.resource.data.keys().hasOnly(['groupID', 'meetupID', 'createdAt'])
          && request.resource.data.groupID is string
          && request.resource.data.meetupID is string
          && referenceId == request.resource.data.groupID + '_' + request.resource.data.meetupID
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/groups/$(request.resource.data.groupID)/members/$(userId))
          && existsAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupID)/meetups/$(request.resource.data.meetupID))
          && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupID)/meetups/$(request.resource.data.meetupID)).data.groupID == request.resource.data.groupID
          && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupID)/meetups/$(request.resource.data.meetupID)).data.ownerUID == request.auth.uid
          && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupID)/meetups/$(request.resource.data.meetupID)).data.participantUIDs.hasAny([userId]);

        allow update, delete: if false;
      }

      match /meetups/{meetupId} {
        allow get, list: if verifiedUser() && request.auth.uid == userId;

        allow create: if verifiedUser()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'title', 'participants', 'candidateTimes', 'location', 'status', 'ownerUID', 'createdAt'
          ])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 80
          && request.resource.data.participants is list
          && request.resource.data.participants.size() > 0
          && request.resource.data.participants.size() <= 20
          && request.resource.data.candidateTimes is list
          && request.resource.data.candidateTimes.size() > 0
          && request.resource.data.candidateTimes.size() <= 8
          && request.resource.data.status == 'planning'
          && request.resource.data.ownerUID == userId
          && request.resource.data.createdAt == request.time
          && (!('location' in request.resource.data.keys())
            || (request.resource.data.location is string
              && request.resource.data.location.size() <= 100));

        allow update, delete: if false;
      }
    }

    match /groups/{groupId} {
      allow get: if isGroupMember(groupId);
      allow list: if false;
      allow create: if verifiedUser()
        && request.resource.data.keys().hasOnly(['name', 'createdBy', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 50
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'owner';

      allow update, delete: if false;

      match /meetups/{meetupId} {
        allow get: if isMeetupParticipant(groupId, meetupId);
        allow list: if false;

        allow create: if isGroupMember(groupId)
          && request.resource.data.keys().hasOnly([
            'groupID', 'title', 'participants', 'participantUIDs', 'candidateIDs', 'candidateTimes',
            'location', 'status', 'ownerUID', 'createdAt'
          ])
          && request.resource.data.groupID == groupId
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 80
          && request.resource.data.participants is list
          && request.resource.data.participants.size() > 0
          && request.resource.data.participants.size() <= 20
          && request.resource.data.participantUIDs is list
          && request.resource.data.participantUIDs.size() > 0
          && request.resource.data.participantUIDs.size() <= 20
          && request.resource.data.participantUIDs.size() == request.resource.data.participants.size()
          && request.resource.data.participantUIDs.hasAll([request.auth.uid])
          && request.resource.data.candidateIDs is list
          && request.resource.data.candidateIDs.size() > 0
          && request.resource.data.candidateIDs.size() <= 8
          && request.resource.data.candidateTimes is list
          && request.resource.data.candidateTimes.size() > 0
          && request.resource.data.candidateTimes.size() <= 8
          && request.resource.data.candidateTimes.size() == request.resource.data.candidateIDs.size()
          && request.resource.data.status == 'planning'
          && request.resource.data.ownerUID == request.auth.uid
          && request.resource.data.createdAt == request.time
          && (!('location' in request.resource.data.keys())
            || (request.resource.data.location is string
              && request.resource.data.location.size() <= 100));

        allow update: if isMeetupParticipant(groupId, meetupId)
          && resource.data.ownerUID == request.auth.uid
          && resource.data.status == 'planning'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'confirmedCandidateID', 'confirmedAt'
          ])
          && request.resource.data.status == 'confirmed'
          && request.resource.data.confirmedCandidateID is string
          && resource.data.candidateIDs.hasAny([request.resource.data.confirmedCandidateID])
          && request.resource.data.confirmedAt == request.time;
        allow delete: if false;

        match /availability/{userId} {
          allow get, list: if isMeetupParticipant(groupId, meetupId);

          allow create, update: if isMeetupParticipant(groupId, meetupId)
            && userId == request.auth.uid
            && get(/databases/$(database)/documents/groups/$(groupId)/meetups/$(meetupId)).data.status == 'planning'
            && request.resource.data.keys().hasOnly(['availableCandidateIDs', 'updatedAt'])
            && request.resource.data.availableCandidateIDs is list
            && request.resource.data.availableCandidateIDs.size() <= 8
            && get(/databases/$(database)/documents/groups/$(groupId)/meetups/$(meetupId)).data.candidateIDs
              .hasAll(request.resource.data.availableCandidateIDs)
            && request.resource.data.updatedAt == request.time;

          allow delete: if false;
        }

        match /arrivalStates/{userId} {
          allow get, list: if isMeetupParticipant(groupId, meetupId);

          allow create, update: if isMeetupParticipant(groupId, meetupId)
            && userId == request.auth.uid
            && get(/databases/$(database)/documents/groups/$(groupId)/meetups/$(meetupId)).data.status == 'confirmed'
            && request.resource.data.keys().hasOnly(['userID', 'state', 'updatedAt'])
            && request.resource.data.userID == userId
            && request.resource.data.state in ['notStarted', 'leavingSoon', 'onTheWay', 'arrivingSoon', 'arrived']
            && request.resource.data.updatedAt == request.time;

          allow delete: if false;
        }
      }

      match /members/{memberId} {
        allow get, list: if isGroupMember(groupId);

        allow create: if verifiedUser()
          && memberId == request.auth.uid
          && request.resource.data.keys().hasOnly(['displayName', 'role', 'joinedAt', 'inviteId'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 80
          && request.resource.data.joinedAt == request.time
          && existsAfter(/databases/$(database)/documents/groups/$(groupId))
          && (
            (request.resource.data.role == 'owner'
              && !('inviteId' in request.resource.data.keys())
              && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid)
            ||
            (request.resource.data.role == 'member'
              && request.resource.data.inviteId is string
              && exists(/databases/$(database)/documents/groupInvites/$(request.resource.data.inviteId))
              && get(/databases/$(database)/documents/groupInvites/$(request.resource.data.inviteId)).data.groupID == groupId
              && get(/databases/$(database)/documents/groupInvites/$(request.resource.data.inviteId)).data.inviteeEmail == signedInEmail()
              && get(/databases/$(database)/documents/groupInvites/$(request.resource.data.inviteId)).data.status == 'pending'
              && getAfter(/databases/$(database)/documents/groupInvites/$(request.resource.data.inviteId)).data.status == 'accepted'
              && getAfter(/databases/$(database)/documents/groupInvites/$(request.resource.data.inviteId)).data.acceptedByUID == request.auth.uid)
          );

        allow update, delete: if false;
      }
    }

    match /groupInvites/{inviteId} {
      allow get, list: if verifiedUser()
        && resource.data.status == 'pending'
        && resource.data.inviteeEmail == signedInEmail();

      allow create: if verifiedUser()
        && request.resource.data.keys().hasOnly([
          'groupID', 'groupName', 'inviteeEmail', 'invitedByUID', 'inviterName', 'status', 'createdAt'
        ])
        && request.resource.data.groupID is string
        && isGroupMember(request.resource.data.groupID)
        && request.resource.data.groupName == get(/databases/$(database)/documents/groups/$(request.resource.data.groupID)).data.name
        && request.resource.data.inviteeEmail is string
        && request.resource.data.inviteeEmail.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && request.resource.data.inviteeEmail == request.resource.data.inviteeEmail.lower()
        && request.resource.data.inviteeEmail != signedInEmail()
        && request.resource.data.invitedByUID == request.auth.uid
        && request.resource.data.inviterName is string
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      allow update: if verifiedUser()
        && resource.data.status == 'pending'
        && resource.data.inviteeEmail == signedInEmail()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedByUID', 'acceptedAt'])
        && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedByUID == request.auth.uid
        && request.resource.data.acceptedAt == request.time
        && existsAfter(/databases/$(database)/documents/groups/$(resource.data.groupID)/members/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/groups/$(resource.data.groupID)/members/$(request.auth.uid)).data.inviteId == inviteId;

      allow delete: if false;
    }
  }
}
